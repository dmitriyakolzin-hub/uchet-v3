# Скопируйте этот файл в .env и заполните пустые значения.
# Команда для заполнения секретов — в deploy/README.md (раздел «Первая установка»).
# Файл .env в git не попадает.

# --- База данных (своя, отдельная от старой системы) ---
POSTGRES_DB=uchet3
POSTGRES_USER=uchet3
# Пароль базы: случайная строка, например из `openssl rand -hex 24`
POSTGRES_PASSWORD=

# --- Вход в систему ---
# Секрет подписи токенов: минимум 32 символа, например из `openssl rand -hex 32`.
# Без него приложение не запустится.
JWT_SECRET=
# Время жизни токенов
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# --- Сеть ---
# Порт на сервере, только для 127.0.0.1 (наружу открывает nginx). Старая система занимает 8000.
APP_PORT=8001
